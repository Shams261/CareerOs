generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum RoadmapItemKind {
  CONCEPT
  QUESTION
}

enum RoadmapItemStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum BlockStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum Independence {
  YES
  PARTIAL
  NO
}

enum LearningStatus {
  PAUSED
  NOT_STARTED
  LEARNING
  NEEDS_REVISION
  INTERVIEW_READY
  COMPLETED
}

enum Confidence {
  RED
  YELLOW
  GREEN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum JobStage {
  SAVED
  APPLIED
  RECRUITER_SCREEN
  ASSESSMENT
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  FINAL
  OFFER
  REJECTED
  WITHDRAWN
}

enum ResourceType {
  PROBLEM
  ARTICLE
  VIDEO
  DOCUMENTATION
  COURSE
  JOB
  REPOSITORY
  OTHER
}

enum SubjectStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LearningActivityType {
  LEARN
  REVIEW
  PRACTICE
  INTERVIEW_RECALL
  MOCK
  NOTE
}

enum NotificationFeedback {
  HELPFUL
  NOT_TODAY
  TOO_MANY
}

enum NotificationType {
  WEEKLY_REVIEW
  TECHNICAL_REVIEW
  DAILY_PROGRESS
  MISSED_CHECK_IN
  UPCOMING_BLOCK
  OVERDUE_TASK
  JOB_FOLLOW_UP
  INTERVIEW
  DSA_REVISION
  STUDY_MORNING
  STUDY_EVENING
  /// WI-039: a study block's start passed with no session or decision.
  STUDY_BLOCK
}

model User {
  authSessions       Session[]
  pushSubscriptions  PushSubscription[]
  weeklyReviews      WeeklyReview[]
  weeklyPriorities   WeeklyPriority[]
  calendarConnection CalendarConnection?
  calendarConflicts  CalendarSyncConflict[]
  jobActivities      JobActivity[]
  interviewRounds    InterviewRound[]
  prepItems          InterviewPrepItem[]
  subjects           LearningSubject[]        @relation("OwnedSubjects")
  learningActivities LearningActivity[]
  currentSubjectId   String?
  currentSubject     LearningSubject?         @relation("CurrentSubject", fields: [currentSubjectId], references: [id], onDelete: SetNull)
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String
  timezone           String                   @default("America/Toronto")
  /// Last time a Silsila page was visible (WI-028 presence beat); nudges go in-app while recent.
  lastActiveAt       DateTime?                @db.Timestamptz(3)
  /// WI-033: the Day Print after a closed day. Null until the owner chooses keep (true) or remove (false).
  dayPrint           Boolean?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  goals              Goal[]
  roadmaps           Roadmap[]
  roadmapItems       RoadmapItem[]
  quickNotes         QuickNote[]
  plans              DailyPlan[]
  sessions           ActualSession[]
  problems           DsaProblem[]
  topics             LearningTopic[]
  jobs               JobApplication[]
  resources          Resource[]
  checkIns           DailyCheckIn[]
  preferences        NotificationPreference[]
  notifications      NotificationLog[]
  dsaAttempts        DsaAttempt[]
  currentDsaTopicId  String?
  currentDsaTopic    DsaTopic?                @relation(fields: [currentDsaTopicId], references: [id], onDelete: SetNull)
  routines           RoutineBlock[]
  studyNudges        StudyNudgeSetting?
  aiSetting          AiSetting?
  aiUsage            AiUsage[]
  revisionCards      RevisionCard[]
  agentConversations AgentConversation[]
  agentMessages      AgentMessage[]
  agentMemories      AgentMemory[]
  prepDocs           InterviewPrepDoc[]
  noticedAnswers     NoticedAnswer[]
}

model Goal {
  weeklyPriorities WeeklyPriority[]
  roadmaps         Roadmap[]
  subjects         LearningSubject[]
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         String
  status           GoalStatus        @default(ACTIVE)
  targetDate       DateTime?         @db.Date
  priority         Int               @default(2)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  blocks           TimeBlock[]
  sessions         ActualSession[]
  topics           LearningTopic[]
  resources        Resource[]
  routines         RoutineBlock[]

  @@index([userId, status])
}

model DailyPlan {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  notes       String?
  generatedAt DateTime?     @db.Timestamptz(3)
  reviewedAt  DateTime?     @db.Timestamptz(3)
  /// The owner marked this day as rest (WI-028): evening study check-ins stop for the day.
  restAt      DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  blocks      TimeBlock[]
  checkIn     DailyCheckIn?

  @@unique([userId, date])
}

model TimeBlock {
  id                      String                 @id @default(cuid())
  dailyPlanId             String
  dailyPlan               DailyPlan              @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  goalId                  String?
  goal                    Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title                   String
  description             String?
  category                String
  plannedStart            DateTime               @db.Timestamptz(3)
  plannedEnd              DateTime               @db.Timestamptz(3)
  status                  BlockStatus            @default(PLANNED)
  priority                Int                    @default(2)
  completedAt             DateTime?              @db.Timestamptz(3)
  externalCalendarEventId String?
  externalCalendarId      String?
  calendarSyncedAt        DateTime?              @db.Timestamptz(3)
  /// Google etag of the last event version CareerOS saw or wrote (If-Match on pushes).
  calendarEtag            String?
  /// Fingerprint of the last representation both sides agreed on (title/start/end/cancelled).
  calendarSyncedHash      String?
  calendarSyncStatus      CalendarSyncStatus     @default(NOT_SYNCED)
  /// Sanitized error code only; never raw API output.
  calendarSyncError       String?
  calendarSyncAttempts    Int                    @default(0)
  calendarRetryAt         DateTime?              @db.Timestamptz(3)
  interviewRoundId        String?                @unique
  interviewRound          InterviewRound?        @relation(fields: [interviewRoundId], references: [id], onDelete: SetNull)
  calendarConflicts       CalendarSyncConflict[]
  occurrenceDate          DateTime?              @db.Date
  isOverride              Boolean                @default(false)
  skipReason              String?
  routineKey              String?
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)
  sessions                ActualSession[]

  @@unique([routineKey, occurrenceDate])
  @@index([category, plannedStart])
}

model ActualSession {
  learningActivities LearningActivity[]
  dsaAttempts        DsaAttempt[]
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId             String?
  task               TimeBlock?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goalId             String?
  goal               Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  category           String
  startedAt          DateTime           @db.Timestamptz(3)
  endedAt            DateTime?          @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  @@index([userId, startedAt])
}

model DsaTopic {
  prepItems    InterviewPrepItem[]
  roadmapItems RoadmapItem[]
  currentFor   User[]
  id           String              @id @default(cuid())
  name         String              @unique
  description  String?
  status       LearningStatus      @default(NOT_STARTED)
  ordering     Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  problems     DsaProblem[]
}

model DsaProblem {
  prepItems       InterviewPrepItem[]
  roadmapItems    RoadmapItem[]
  attempts        DsaAttempt[]
  revisionStage   Int                 @default(0)
  revisionManual  Boolean             @default(false)
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  platform        String
  problemUrl      String
  difficulty      Difficulty
  topicId         String
  topic           DsaTopic            @relation(fields: [topicId], references: [id])
  confidence      Confidence          @default(RED)
  notes           String?
  lastAttemptedAt DateTime?           @db.Timestamptz(3)
  nextRevisionAt  DateTime?           @db.Date
  attemptsCount   Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  resources       Resource[]

  @@index([userId, nextRevisionAt])
}

model LearningSubject {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation("OwnedSubjects", fields: [userId], references: [id], onDelete: Cascade)
  currentFor  User[]          @relation("CurrentSubject")
  name        String
  description String?
  status      SubjectStatus   @default(NOT_STARTED)
  ordering    Int             @default(0)
  goalId      String?
  goal        Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  topics      LearningTopic[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([userId, name])
  @@index([userId, status])
}

model LearningActivity {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  topic           LearningTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  requestId       String
  activityType    LearningActivityType
  performedAt     DateTime             @db.Timestamptz(3)
  understanding   Int?
  recall          Int?
  application     Int?
  interview       Int?
  statusBefore    LearningStatus
  statusAfter     LearningStatus
  durationMinutes Int?
  notes           String?
  actualSessionId String?
  actualSession   ActualSession?       @relation(fields: [actualSessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([userId, requestId])
  @@index([userId, performedAt])
  @@index([topicId, performedAt])
}

model LearningTopic {
  prepItems      InterviewPrepItem[]
  roadmapItems   RoadmapItem[]
  subjectId      String
  subject        LearningSubject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  description    String?
  ordering       Int                 @default(0)
  understanding  Int                 @default(0)
  recall         Int                 @default(0)
  application    Int                 @default(0)
  interview      Int                 @default(0)
  lastReviewedAt DateTime?           @db.Timestamptz(3)
  nextReviewDate DateTime?           @db.Date
  reviewManual   Boolean             @default(false)
  activities     LearningActivity[]
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  status         LearningStatus      @default(NOT_STARTED)
  goalId         String?
  goal           Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         LearningTopic?      @relation("TopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       LearningTopic[]     @relation("TopicTree")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  resources      Resource[]

  @@index([userId, status])
}

model JobApplication {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           String
  role              String
  jobUrl            String?
  location          String?
  workArrangement   WorkArrangement    @default(UNKNOWN)
  employmentType    String?
  source            String?
  appliedAt         DateTime?          @db.Date
  stage             JobStage           @default(SAVED)
  priority          Int                @default(2)
  recruiterName     String?
  recruiterContact  String?
  hiringContact     String?
  notes             String?
  compensationNotes String?
  jobDescription    String?
  nextAction        String?
  nextActionDate    DateTime?          @db.Date
  actionOwner       ActionOwner        @default(NONE)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  resources         Resource[]
  activities        JobActivity[]
  rounds            InterviewRound[]
  prepDocs          InterviewPrepDoc[]

  @@index([userId, nextActionDate])
  @@index([userId, stage])
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum ActionOwner {
  ME
  COMPANY
  NONE
}

enum JobActivityType {
  CREATED
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_RESULT
  FOLLOW_UP_SET
  FOLLOW_UP_DONE
  NOTE
}

enum InterviewType {
  RECRUITER
  ASSESSMENT
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  HIRING_MANAGER
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrepKind {
  PREP
  GAP
}

model JobActivity {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId    String
  application      JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type             JobActivityType
  occurredAt       DateTime        @db.Timestamptz(3)
  fromStage        JobStage?
  toStage          JobStage?
  interviewRoundId String?
  interviewRound   InterviewRound? @relation(fields: [interviewRoundId], references: [id], onDelete: SetNull)
  previousStart    DateTime?       @db.Timestamptz(3)
  newStart         DateTime?       @db.Timestamptz(3)
  note             String?
  requestId        String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([userId, requestId])
  @@index([applicationId, occurredAt])
  @@index([userId, occurredAt])
}

model InterviewRound {
  scheduleBlock  TimeBlock?
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String
  application    JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title          String
  type           InterviewType       @default(OTHER)
  scheduledStart DateTime            @db.Timestamptz(3)
  scheduledEnd   DateTime?           @db.Timestamptz(3)
  timezone       String
  status         InterviewStatus     @default(SCHEDULED)
  interviewers   String?
  meetingUrl     String?
  location       String?
  notes          String?
  topicsAsked    String?
  wentWell       String?
  toImprove      String?
  outcomeNotes   String?
  completedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  prepItems      InterviewPrepItem[]
  activities     JobActivity[]

  @@index([userId, scheduledStart])
  @@index([applicationId, scheduledStart])
}

model InterviewPrepItem {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId         String
  round           InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  kind            PrepKind       @default(PREP)
  title           String
  notes           String?
  completed       Boolean        @default(false)
  completedAt     DateTime?      @db.Timestamptz(3)
  ordering        Int            @default(0)
  learningTopicId String?
  learningTopic   LearningTopic? @relation(fields: [learningTopicId], references: [id], onDelete: SetNull)
  dsaProblemId    String?
  dsaProblem      DsaProblem?    @relation(fields: [dsaProblemId], references: [id], onDelete: SetNull)
  dsaTopicId      String?
  dsaTopic        DsaTopic?      @relation(fields: [dsaTopicId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([roundId, ordering])
  @@index([learningTopicId])
  @@index([dsaProblemId])
}

model Resource {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  url              String
  type             ResourceType    @default(OTHER)
  notes            String?
  problemId        String?
  problem          DsaProblem?     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  learningTopicId  String?
  learningTopic    LearningTopic?  @relation(fields: [learningTopicId], references: [id], onDelete: Cascade)
  goalId           String?
  goal             Goal?           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  jobApplicationId String?
  jobApplication   JobApplication? @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model DailyCheckIn {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlanId  String    @unique
  dailyPlan    DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  completedAt  DateTime  @db.Timestamptz(3)
  rating       Int?
  notes        String?
  carryForward String?
  blocker      String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
}

model RoutineBlock {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekdays    Int[]
  description String?
  priority    Int      @default(2)
  startLocal  String
  endLocal    String
  title       String
  category    String
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, enabled])
}

model NotificationPreference {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  enabled       Boolean          @default(true)
  offsetMinutes Int              @default(15)
  preferredTime String           @default("21:30")
  timezone      String           @default("America/Toronto")

  @@unique([userId, type])
}

model NotificationLog {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  scheduledFor DateTime              @db.Timestamptz(3)
  /// Set when at least one device accepted the Web Push delivery.
  sentAt       DateTime?             @db.Timestamptz(3)
  pushAttempts Int                   @default(0)
  readAt       DateTime?             @db.Timestamptz(3)
  /// When the owner opened Silsila from this notification (R3); set once.
  openedAt     DateTime?             @db.Timestamptz(3)
  /// The owner's answer to "Useful?" (R3; asked by Study Nudges from WI-028).
  feedback     NotificationFeedback?
  dedupeKey    String                @unique
  /// Shown in the inbox and on Today only, never pushed (WI-028: Silsila was open).
  inAppOnly    Boolean               @default(false)
  metadata     Json?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, scheduledFor])
}

model DsaAttempt {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId           String
  problem             DsaProblem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  requestId           String
  attemptedAt         DateTime       @db.Timestamptz(3)
  confidenceBefore    Confidence?
  confidenceAfter     Confidence
  solvedIndependently Independence
  durationMinutes     Int?
  notes               String?
  mistake             String?
  actualSessionId     String?
  actualSession       ActualSession? @relation(fields: [actualSessionId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([userId, requestId])
  @@index([userId, attemptedAt])
  @@index([problemId, attemptedAt])
}

/// Operational ledger for one-off data maintenance (e.g. the legacy timestamp repair). Written only by
/// guarded scripts; a record's presence blocks accidental re-execution of the same operation.
model MaintenanceRecord {
  id          String   @id
  performedAt DateTime @db.Timestamptz(3)
  details     Json
}

enum CalendarConnectionStatus {
  DISCONNECTED
  CONNECTED
  REAUTH_REQUIRED
  ERROR
}

enum CalendarSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
  CONFLICT
  /// The Google event was deleted while the block was already done; never recreated.
  DETACHED
}

enum CalendarConflictStatus {
  OPEN
  RESOLVED_LOCAL
  RESOLVED_REMOTE
}

/// One Google connection per owner, including its incremental sync state.
model CalendarConnection {
  id                    String                   @id @default(cuid())
  userId                String                   @unique
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String                   @default("google")
  accountEmail          String?
  /// AES-256-GCM envelope (v1:iv:tag:ciphertext); the key lives only in the environment.
  encryptedRefreshToken String?
  scope                 String?
  calendarId            String?
  calendarName          String?
  status                CalendarConnectionStatus @default(DISCONNECTED)
  excludedCategories    String[]                 @default([])
  syncToken             String?
  /// Lease that keeps overlapping sync runs (cron, webhook, Sync now) from interleaving.
  syncLeaseUntil        DateTime?                @db.Timestamptz(3)
  lastSyncAttemptAt     DateTime?                @db.Timestamptz(3)
  lastSuccessfulSyncAt  DateTime?                @db.Timestamptz(3)
  lastFullSyncAt        DateTime?                @db.Timestamptz(3)
  lastIncrementalSyncAt DateTime?                @db.Timestamptz(3)
  lastSyncError         String?
  lastSyncSummary       Json?
  connectedAt           DateTime?                @db.Timestamptz(3)
  disconnectedAt        DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  channels              CalendarWatchChannel[]
}

model CalendarWatchChannel {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channelId    String             @unique
  resourceId   String?
  /// SHA-256 of the channel token; the token itself is never stored.
  tokenHash    String
  expiration   DateTime           @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  stoppedAt    DateTime?          @db.Timestamptz(3)

  @@index([connectionId, stoppedAt])
}

/// Both sides changed since the last agreed version. Snapshots hold title/start/end only.
model CalendarSyncConflict {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeBlockId     String
  timeBlock       TimeBlock              @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  providerEventId String
  localSnapshot   Json
  remoteSnapshot  Json
  status          CalendarConflictStatus @default(OPEN)
  detectedAt      DateTime               @db.Timestamptz(3)
  resolvedAt      DateTime?              @db.Timestamptz(3)

  @@index([userId, status])
  @@index([timeBlockId, status])
}

/// The owner's written weekly review. Metrics are derived live from source data, never copied here.
model WeeklyReview {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Owner-local Monday of the reviewed week.
  weekStart      DateTime         @db.Date
  biggestWin     String?
  biggestBlocker String?
  lessons        String?
  nextWeekChange String?
  carryForward   String?
  completedAt    DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  priorities     WeeklyPriority[]

  @@unique([userId, weekStart])
}

/// Up to five priorities chosen during a review for the following week.
model WeeklyPriority {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId    String
  review      WeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  goalId      String?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  target      Int?
  targetUnit  String?
  ordering    Int
  completedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([reviewId, ordering])
}

/// Server-side owner session. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

/// A browser/device Web Push subscription (Push API + VAPID). Delivery requires the server's
/// VAPID private key, which lives only in the environment.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastFailureAt DateTime? @db.Timestamptz(3)
  failureCount  Int       @default(0)
  revokedAt     DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
}

/// Last run of each scheduled job, for the Settings status panel.
model JobRun {
  name            String    @id
  lastStartedAt   DateTime? @db.Timestamptz(3)
  lastSucceededAt DateTime? @db.Timestamptz(3)
  lastFailedAt    DateTime? @db.Timestamptz(3)
  lastError       String?
  lastSummary     Json?
}

/// WI-009: an interview roadmap is a planning layer. Items may point at a Learn topic or a
/// Practice problem/topic but never change mastery, attempts or revision dates.
model Roadmap {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  goalId         String?
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  ordering       Int           @default(0)
  archivedAt     DateTime?     @db.Timestamptz(3)
  /// Study prompt template; `{{topic}} {{section}} {{scope}} {{checkpoint}} {{priority}} {{references}} {{scenario}} {{extra}}`.
  promptTemplate String?       @db.Text
  /// Prompt scenarios `[{ id, name, intro }]` offered when copying a study prompt.
  scenarios      Json?
  /// Grill Me may send this roadmap's items (WI-031): off for owner-made roadmaps and the behavioural one.
  studyAi        Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  items          RoadmapItem[]

  @@index([userId, ordering])
}

model RoadmapItem {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId        String
  roadmap          Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  section          String
  kind             RoadmapItemKind   @default(CONCEPT)
  title            String
  /// Import key within a roadmap (bundle slug); owner-added items have none.
  slug             String?
  /// What to cover; the owner's revision notes live in `notes`.
  scope            String?           @db.Text
  /// What "done" means for this item.
  checkpoint       String?           @db.Text
  /// 1 = P0, 2 = P1, 3 = P2.
  priority         Int               @default(2)
  estimateMinutes  Int?
  /// Curated starting points `[{ label, url, kind? }]`; read-only in the app.
  references       Json?
  /// Where the item came from ("Backend week 3", "DSA Pattern Bible ch. 5").
  sourceRef        String?
  notes            String?           @db.Text
  url              String?
  status           RoadmapItemStatus @default(NOT_STARTED)
  completedAt      DateTime?         @db.Timestamptz(3)
  /// Spaced revision after Done: stage 1 → 7 days, 2 → 14, 3 → 30, then 60. A calendar label.
  nextRevisionAt   DateTime?         @db.Date
  revisionStage    Int               @default(0)
  lastRevisedAt    DateTime?         @db.Timestamptz(3)
  askedInInterview Boolean           @default(false)
  askedNote        String?
  ordering         Int               @default(0)
  learningTopicId  String?
  learningTopic    LearningTopic?    @relation(fields: [learningTopicId], references: [id], onDelete: SetNull)
  dsaProblemId     String?
  dsaProblem       DsaProblem?       @relation(fields: [dsaProblemId], references: [id], onDelete: SetNull)
  dsaTopicId       String?
  dsaTopic         DsaTopic?         @relation(fields: [dsaTopicId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  revisionCards RevisionCard[]

  @@unique([roadmapId, slug])
  @@index([userId, nextRevisionAt])
  @@index([roadmapId, section, ordering])
  @@index([userId, status])
  @@index([learningTopicId])
  @@index([dsaProblemId])
}

/// WI-010: a note to self captured from any page; it waits on Today until marked done.
model QuickNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  doneAt    DateTime? @db.Timestamptz(3)

  @@index([userId, doneAt, createdAt])
}

/// Study Nudges (WI-028): off by default; evaluated against the latest plan at each cron run.
model StudyNudgeSetting {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningEnabled    Boolean   @default(false)
  morningTime       String    @default("08:00")
  eveningEnabled    Boolean   @default(false)
  eveningTime       String    @default("19:30")
  /// Weekdays as bits, Monday = 1 … Sunday = 64; Mon–Fri by default.
  days              Int       @default(31)
  onlyStudyDays     Boolean   @default(true)
  quietStart        String    @default("22:00")
  quietEnd          String    @default("07:30")
  /// Paused through this owner-calendar day (DATE label).
  pausedUntil       DateTime? @db.Date
  studyCategories   String[]  @default(["DSA", "Technical"])
  /// WI-039: a nudge when a study block's start has passed by this many minutes with nothing begun.
  blockStartEnabled Boolean   @default(false)
  blockStartMinutes Int       @default(15)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

/// WI-031: what a Grill Me request is for (the ledger never holds content).
enum AiFeature {
  GRILL_ITEM
  /// WI-032: the hint ladder on a Practice problem. Retired in WI-038; kept for ledger rows.
  GRILL_PROBLEM
  /// WI-037: a Listen script from an item's fetched sources.
  LISTEN_ITEM
  /// WI-040: one model call of an Ask Rumi message (a message can take several).
  AGENT_CHAT
  /// WI-042: one search or the writing call of an interview prep doc.
  PREP_RESEARCH
}

enum AiOutcome {
  /// Reserved before the call; counts towards the cap until it settles.
  PENDING
  OK
  FAILED
}

/// The owner's AI switch and the provider check (ADR-022). A failed daily check blocks AI
/// until the owner checks again and it passes.
model AiSetting {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(true)
  checkedAt     DateTime? @db.Timestamptz(3)
  blockedAt     DateTime? @db.Timestamptz(3)
  blockedReason String?
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

/// One row per AI request: model, endpoint, tokens and cost in millionths of a US dollar. No
/// prompt or answer is stored.
model AiUsage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AiFeature
  model        String
  provider     String
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costMicros   Int
  outcome      AiOutcome @default(PENDING)
  durationMs   Int?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

/// A Grill Me rung the owner chose to keep for revision (WI-031); the deck is WI-032.
model RevisionCard {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItemId String
  roadmapItem   RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
  question      String
  change        String?
  points        String[]
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([roadmapItemId, question])
  @@index([userId, createdAt])
}

/// WI-040 (ADR-024): who wrote an Ask Rumi message.
enum AgentRole {
  USER
  ASSISTANT
}

/// WI-040: one Ask Rumi conversation. Owner material: deletable and in the export.
model AgentConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  messages  AgentMessage[]

  @@index([userId, updatedAt])
}

/// WI-040: one message. Tool results are never stored; `metadata` holds only tool names, rounds and cost.
model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           AgentRole
  content        String            @db.Text
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
}

/// WI-040: "Rumi knows", lines the owner wrote for Rumi to keep in mind. Sent with every message.
model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

/// WI-042 (ADR-024): an interview prep doc Rumi wrote from web research. Owner material: deletable and in the export.
model InterviewPrepDoc {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId      String
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// The company and role when it was written.
  company            String
  role               String
  /// The searches sent (built by code from company, role and round types).
  queries            String[]
  usedJobDescription Boolean        @default(false)
  /// The checked doc (`PrepDoc`) and its cited sources.
  content            Json
  sources            Json
  costMicros         Int            @default(0)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId, applicationId, createdAt])
}

/// WI-043: the owner's answer to a "Rumi noticed" card. It hides the card until `hiddenUntil`
/// and counts acted versus dismissed for the plan's measure. Nothing else is stored.
model NoticedAnswer {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The card's key, such as "idle:technical" or "interview:<round id>".
  key         String
  kind        String
  hiddenUntil DateTime  @db.Date
  actedAt     DateTime? @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, key])
}
