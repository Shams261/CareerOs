# Environment for the local production rehearsal: `docker compose --profile app up --build`.
# Copy to .env.docker (git-ignored) and adjust. DATABASE_URL is set by compose.yaml to the
# bundled Postgres 17 service, so it is not listed here. Reference: docs/engineering/environment.md.
NODE_ENV=production
DATABASE_SSL=off
DATABASE_POOL_MAX=5
OWNER_EMAIL=owner@example.com
# openssl rand -base64 36
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# HTTPS is required in production; the rehearsal only checks headers and redirects, so a
# placeholder public origin is fine. Sign-in cannot complete without a real Google client.
APP_BASE_URL=https://usesilsila.me
# openssl rand -base64 32
AUTH_SECRET=
GOOGLE_CLIENT_ID=rehearsal-client
GOOGLE_CLIENT_SECRET=rehearsal-secret
