DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros
OWNER_EMAIL=owner@example.com
APP_PASSWORD=replace-with-at-least-16-characters
CRON_SECRET=replace-with-a-different-32-character-secret
# Google Calendar (optional, WI-006). Leave GOOGLE_CLIENT_ID empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
# 32 random bytes, base64: openssl rand -base64 32. Never commit a real key.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Public HTTPS origin for Google push notifications; omit locally (manual/cron sync still works).
GOOGLE_CALENDAR_WEBHOOK_BASE_URL=
