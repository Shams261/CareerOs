# Reference: docs/engineering/environment.md. Never commit real values.
DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros
# Connections per server process (default 5). Keep small for managed/pooled PostgreSQL.
DATABASE_POOL_MAX=5
# The only Google account allowed to sign in.
OWNER_EMAIL=owner@example.com
# Scheduler bearer secret, at least 32 characters: openssl rand -base64 36
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Owner sign-in (required). The public origin; HTTPS in production.
APP_BASE_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32. Encrypts the short-lived sign-in cookie.
AUTH_SECRET=
# Google OAuth web client. Register {APP_BASE_URL}/api/auth/callback
# (and {APP_BASE_URL}/api/calendar/oauth/callback for Calendar) as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development without a Google client: run `pnpm google:fake` and uncomment.
# Endpoint overrides are accepted only for loopback URLs.
# GOOGLE_CLIENT_ID=fake-client
# GOOGLE_CLIENT_SECRET=fake-secret
# GOOGLE_OAUTH_AUTH_URL=http://127.0.0.1:4455/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:4455/token
# GOOGLE_OAUTH_REVOKE_URL=http://127.0.0.1:4455/revoke
# GOOGLE_CALENDAR_API_URL=http://127.0.0.1:4455/calendar/v3

# Google Calendar sync (optional). Enabled when this key is set: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Defaults to {APP_BASE_URL}/api/calendar/oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# Public HTTPS origin for Google push notifications; omit locally (manual/cron sync still works).
GOOGLE_CALENDAR_WEBHOOK_BASE_URL=

# Web Push (optional). Generate once: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
